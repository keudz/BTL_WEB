@model BTL_WEB.Models.Entities.Food
@{
    ViewData["Title"] = "Thêm món ăn mới (Pro VIP)";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="kit-card p-4 p-md-5">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle text-success me-2"></i>Thêm Món Ăn Hệ Thống</h4>
                    <a asp-action="Manage" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold small"></label>
                        <input asp-for="Name" class="form-control" placeholder="VD: Bún riêu cua đồng" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ServingSize" class="form-label fw-semibold small"></label>
                        <input asp-for="ServingSize" class="form-control" placeholder="VD: 1 tô (450ml)" />
                        <span asp-validation-for="ServingSize" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Calories" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <input asp-for="Calories" type="number" class="form-control" placeholder="420" />
                                <span class="input-group-text bg-light text-muted small">kcal</span>
                            </div>
                            <span asp-validation-for="Calories" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="TrafficLightStatic" class="form-label fw-semibold small">Đèn Giao Thông tĩnh (Override)</label>
                            <select asp-for="TrafficLightStatic" class="form-select">
                                <option value="GREEN">🟢 Xanh (Mặc định ≤200 calo)</option>
                                <option value="YELLOW">🟡 Vàng (Mặc định 200-500 calo)</option>
                                <option value="RED">🔴 Đỏ (Mặc định >500 calo)</option>
                            </select>
                            <span class="form-text small text-muted">Tài khoản Pro VIP có quyền override nhãn Đèn Giao Thông.</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-4">
                            <label asp-for="Protein" class="form-label fw-semibold small">Chất đạm (g)</label>
                            <input asp-for="Protein" type="number" step="0.1" class="form-control" placeholder="20" />
                            <span asp-validation-for="Protein" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="Carbs" class="form-label fw-semibold small">Tinh bột (g)</label>
                            <input asp-for="Carbs" type="number" step="0.1" class="form-control" placeholder="55" />
                            <span asp-validation-for="Carbs" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="Fat" class="form-label fw-semibold small">Chất béo (g)</label>
                            <input asp-for="Fat" type="number" step="0.1" class="form-control" placeholder="12" />
                            <span asp-validation-for="Fat" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Manage" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-kit-primary px-4">
                            <i class="bi bi-save me-1"></i> Lưu vào Thư viện
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
