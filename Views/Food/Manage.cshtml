@model List<BTL_WEB.Models.Entities.Food>
@{
    ViewData["Title"] = "Quản lý Thư viện Món ăn (Pro VIP)";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string search = ViewBag.Search ?? "";
    string filter = ViewBag.Filter ?? "ALL";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-sliders text-warning me-2"></i>Quản lý Thư viện Món ăn (Pro VIP)</h3>
            <p class="text-muted small mb-0">Thêm, sửa, xóa món ăn chuẩn hóa và override nhãn Đèn Giao Thông</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-kit-primary">
                <i class="bi bi-plus-lg me-1"></i> Thêm món ăn mới
            </a>
        </div>
    </div>

    <!-- Filter & Search Form -->
    <div class="kit-card p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Tìm theo tên món ăn..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="filter" class="form-select">
                    <option value="ALL" selected="@(filter == "ALL")">Tất cả màu đèn</option>
                    <option value="GREEN" selected="@(filter == "GREEN")">🟢 Xanh (≤200 calo)</option>
                    <option value="YELLOW" selected="@(filter == "YELLOW")">🟡 Vàng (200-500 calo)</option>
                    <option value="RED" selected="@(filter == "RED")">🔴 Đỏ (>500 calo)</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-dark">Lọc dữ liệu</button>
            </div>
        </form>
    </div>

    <!-- Table CRUD -->
    <div class="kit-card table-responsive shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Tên món ăn</th>
                    <th>Khẩu phần</th>
                    <th>Năng lượng</th>
                    <th>Macro (P/C/F)</th>
                    <th>Đèn Giao Thông</th>
                    <th>Nguồn</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">#@item.Id</td>
                            <td class="fw-bold">@item.Name</td>
                            <td class="small text-muted">@item.ServingSize</td>
                            <td><strong class="text-success">@item.Calories</strong> kcal</td>
                            <td class="small text-muted">
                                @item.Protein g / @item.Carbs g / @item.Fat g
                            </td>
                            <td>
                                @if (item.TrafficLightStatic == "GREEN")
                                {
                                    <span class="badge badge-tl-green">🟢 Xanh</span>
                                }
                                else if (item.TrafficLightStatic == "YELLOW")
                                {
                                    <span class="badge badge-tl-yellow">🟡 Vàng</span>
                                }
                                else
                                {
                                    <span class="badge badge-tl-red">🔴 Đỏ</span>
                                }
                            </td>
                            <td>
                                @if (item.IsCustom)
                                {
                                    <span class="badge bg-light text-secondary border">User tự tạo</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border">Hệ thống</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa món này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không có dữ liệu món ăn</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paging -->
    @if (totalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-center">
            <ul class="pagination pagination-sm">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link shadow-none" href="?search=@search&filter=@filter&page=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
